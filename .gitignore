# See https://docs.github.com/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# === Angular build artifacts ===
/dist
/tmp
/out-tsc
/.angular/cache
/bazel-out

# === Node.js dependencies ===
/node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# === IDE and editor files ===
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace
*.sublime-project

# === VS Code ===
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# === Local history / temp ===
.history/
.sass-cache/
connect.lock
coverage/
libpeerconnection.log
testem.log
typings/

# === System files ===
.DS_Store
Thumbs.db

# === Optional: environment files (to avoid committing secrets) ===
# Uncomment if you use environment.local.ts for private keys or API URLs
# src/environments/environment*.ts
